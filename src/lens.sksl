uniform shader iChannel0;
uniform float3 iResolution;
uniform float iTime;
uniform float uFocus;
uniform float uAperture;
uniform float uReveal;
float hash(float2 p){return fract(sin(dot(p,float2(12.9898,78.233)))*43758.5453);}
float3 sampleColor(float2 p){return iChannel0.eval(clamp(p,float2(0.5),float2(1919.5,1079.5))).rgb;}
float depth(float2 p){return 650.0+4350.0*iChannel0.eval(clamp(p,float2(0.5),float2(1919.5,1079.5))+float2(0.0,1080.0)).r;}
half4 main(float2 coord){
    float2 uv=coord/float2(1920.0,1080.0);
    float2 centered=uv-0.5;
    // Very small lens distortion, followed by depth-aware aperture sampling.
    float2 p=coord+centered*dot(centered,centered)*2.0;
    float z=depth(p);
    // Resolve subpixel coverage: gaps between fine grains must inherit the nearby surface,
    // rather than being mistaken for the distant sky and smearing the reference detail.
    for(int k=0;k<8;k++){
        float angle=float(k)*0.785398;
        z=min(z,depth(p+float2(cos(angle),sin(angle))*2.6));
    }
    float coc=clamp(uAperture*abs(z-uFocus)/max(z,650.0),0.15,15.0);
    float3 accum=float3(0.0);float weights=0.0;
    float spin=hash(coord)*6.283185;
    for(int i=0;i<40;i++){
        float fi=float(i);float a=fi*2.39996323+spin;
        float radius=sqrt((fi+0.5)/40.0)*coc;
        float2 q=p+float2(cos(a),sin(a))*radius;
        float3 c=sampleColor(q);
        float w=1.0;
        accum+=c*w;weights+=w;
    }
    float3 col=accum/weights;
    float inFocus=1.0-smoothstep(120.0,450.0,abs(z-uFocus));
    col=mix(col,sampleColor(p),inFocus*0.92);
    // Broad, restrained highlight diffusion; ivory paper never blows out to pure white.
    float3 bloom=float3(0.0);
    for(int j=0;j<12;j++){
        float a=float(j)*2.39996323;
        float2 off=float2(cos(a),sin(a))*(9.0+float(j)*2.2);
        float3 c=sampleColor(p+off);
        bloom+=max(c-float3(0.88),float3(0.0));
    }
    col+=bloom/12.0*0.16;
    // The lighting opens as the form settles. A broad veil gives the sky depth.
    float beam=exp(-pow((uv.x-0.43-uv.y*0.10)/0.38,2.0))*0.022;
    col=mix(col,float3(1.0,0.978,0.923),beam*(0.55+0.45*uReveal));
    float lum=dot(col,float3(0.2126,0.7152,0.0722));
    col=float3(lum);
    col=(col-0.5)*1.035+0.5;
    float vignette=1.0-0.085*dot(centered*float2(0.75,1.0),centered*float2(0.75,1.0));
    col*=vignette;
    col+=(hash(coord+floor(iTime*30.0)*float2(0.73,1.39))-0.5)*0.004;
    return half4(half3(clamp(col,0.0,1.0)),1.0);
}
